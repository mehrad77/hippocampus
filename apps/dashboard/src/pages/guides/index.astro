---
import { getCollection } from "astro:content";
import Shell from "../../layouts/Shell.astro";
import "../../styles/guides.css";
import NavIcon from "../../ui/NavIcon.astro";
import Term from "../../ui/Term.astro";
import { SECTIONS, plainSection } from "../../components/guides/sections.ts";
import { href } from "../../lib/routes.ts";

const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
const first = guides[0];
---
<Shell title="Guides" page="guides" description="How Hippocampus works: the Player's Handbook for humans.">
  <div class="guide-index">
    <header class="guide-hero panel">
      <span class="guide-hero__seal" aria-hidden="true"><NavIcon name="d20" size={44} /></span>
      <div class="guide-hero__text">
        <p class="page-head__kicker"><Term k="guides" /></p>
        <h1><Term k="handbook" /></h1>
        <p class="guide-hero__lede">
          <span class="lbl-plain">
            Your agents read <code>HANDBOOK.md</code>. These guides are for you: how a team of agents shares one memory, why
            some facts are confirmed and others unverified, and where your decisions come in.
          </span>
          <span class="lbl-codex">
            Your agents get <code>HANDBOOK.md</code>. This one is for you: how a party of agents shares one memory, why some
            facts are canon and others only rumor, and where your word comes in.
          </span>
        </p>
        <div class="row guide-hero__actions">
          {first && (
            <a class="btn btn--primary" href={href.guide(first.id)}>
              <NavIcon name="scroll" /> Start with {first.data.title}
            </a>
          )}
          <a class="btn btn--ghost" href="#reading-order"><NavIcon name="guides" /> Reading order</a>
        </div>
      </div>
    </header>

    {SECTIONS.map((section) => {
      const items = guides.filter((g) => g.data.section === section.name);
      if (!items.length) return null;
      const id = section.name.toLowerCase().replace(/\s+/g, "-");
      return (
        <section class="guide-section" aria-labelledby={`section-${id}`}>
          <div class="ornament"><span>✦</span></div>
          <div class="guide-section__head">
            <h2 id={`section-${id}`}><Term plain={section.plain} codex={section.name} /></h2>
            <p class="muted"><Term plain={section.blurb[0]} codex={section.blurb[1]} /></p>
          </div>
          <ul class="guide-cards">
            {items.map((g) => (
              <li>
                <a class="guide-card panel panel--quiet" href={href.guide(g.id)}>
                  <span class="guide-card__sigil" aria-hidden="true"><NavIcon name={g.data.sigil} size={26} /></span>
                  <span class="guide-card__text">
                    <span class="guide-card__num">Guide {guides.indexOf(g) + 1}</span>
                    <span class="guide-card__title">{g.data.title}</span>
                    <span class="guide-card__summary">{g.data.summary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <section class="guide-section" aria-labelledby="reading-order">
      <div class="ornament"><span>✦</span></div>
      <div class="guide-section__head">
        <h2 id="reading-order">Reading order</h2>
        <p class="muted">
          <Term
            plain="New here? Read the Basics first; the rest works in any order. Each guide links to the next."
            codex="New to the table? Read the Basics first; the rest works in any order. Each guide links to the next."
          />
        </p>
      </div>
      <ol class="guide-order panel panel--quiet">
        {guides.map((g) => (
          <li>
            <a href={href.guide(g.id)}>{g.data.title}</a>
            <span class="muted small"><Term plain={plainSection(g.data.section)} codex={g.data.section} /></span>
          </li>
        ))}
      </ol>
      <p class="guide-edition small">
        <NavIcon name="scroll" size={16} />
        <span><strong><Term plain="Built in:" codex="Edit-free:" /></strong> these guides ship with your version of Hippocampus, so they always match the tool you run. They describe the tool, never your vault.</span>
      </p>
    </section>
  </div>
</Shell>
