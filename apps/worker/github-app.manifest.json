{
  "name": "Hippocampus",
  "description": "Shared, curated memory for your AI agents, kept in a private repo of your own. The app reads and writes only the one repo you install it on.",
  "url": "https://hippocampus.example.workers.dev",
  "callback_urls": ["https://hippocampus.example.workers.dev/oauth/github/callback"],
  "request_oauth_on_install": true,
  "hook_attributes": {
    "url": "https://hippocampus.example.workers.dev/github/webhook",
    "active": true
  },
  "public": true,
  "default_permissions": {
    "contents": "write",
    "workflows": "write",
    "metadata": "read"
  },
  "default_events": ["installation_repositories", "repository"]
}
