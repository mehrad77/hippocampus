# Copy to .env (gitignored). The dev CLI and `hippo` load it from the working directory.
# Vault location (or pass --vault)
HIPPO_VAULT=~/vaults/my-campaign

# Curator LLM: lmstudio | ollama | openai-compatible | anthropic | xai
HIPPO_LLM_PROVIDER=lmstudio
HIPPO_LLM_MODEL=google/gemma-4-26b-a4b-qat
# HIPPO_LLM_BASE_URL=http://localhost:1234/v1   # defaults: lmstudio :1234, ollama :11434
# HIPPO_LLM_API_KEY=                            # or ANTHROPIC_API_KEY / XAI_API_KEY
# HIPPO_LLM_STRUCTURED=prompt                   # prompt (default for local) | native (default for hosted)
# HIPPO_LLM_TIMEOUT_MS=180000                   # per-call timeout (runaway reasoning guard)
# HIPPO_LLM_MAX_TOKENS=8192                     # per-call output cap

# Semantic recall (optional): an embedding model in LM Studio / Ollama, or any OpenAI-compatible API
# HIPPO_EMBED_PROVIDER=lmstudio                 # lmstudio | ollama | openai-compatible | off
# HIPPO_EMBED_MODEL=text-embedding-bge-m3       # unset = keyword search only
# HIPPO_EMBED_BASE_URL=                         # defaults: lmstudio :1234, ollama :11434
# HIPPO_EMBED_API_KEY=
# HIPPO_EMBED_MIN_SIMILARITY=0.35               # raise if unrelated notes show up

# Use the vault repo on GitHub directly instead of a checkout (or pass --github owner/repo[#branch])
# HIPPO_GITHUB_REPO=you/my-campaign
# HIPPO_GITHUB_TOKEN=                           # fine-grained: Contents read+write on the vault repo only
# HIPPO_GITHUB_API_URL=https://api.github.com   # GitHub Enterprise: https://<host>/api/v3

# Agent identity for `hippo serve` (stdio MCP)
# HIPPO_AGENT=residency-agent

# age identity used by `hippo secrets show` (created by `hippo secrets keygen`)
# HIPPO_AGE_IDENTITY_FILE=~/.config/hippocampus/age-identity.txt
